VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:3001
# Prisma with Supabase Postgres:
# - DATABASE_URL should point to the Supavisor session pooler (5432)
# - DIRECT_URL can point to the direct connection or the alternate pooler string used by the backend
DATABASE_URL=
DIRECT_URL=

# Backend server
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SESSION_COOKIE_NAME=riskcare-auth
CSRF_COOKIE_NAME=riskcare-csrf
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=25
